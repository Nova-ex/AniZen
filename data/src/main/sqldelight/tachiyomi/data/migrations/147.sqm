import kotlin.Boolean;

CREATE TABLE remote_servers (
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    protocol TEXT NOT NULL,
    host TEXT NOT NULL,
    port INTEGER NOT NULL,
    username TEXT NOT NULL,
    encrypted_password TEXT NOT NULL,
    encrypted_private_key TEXT NOT NULL,
    encrypted_key_passphrase TEXT NOT NULL,
    initial_path TEXT NOT NULL DEFAULT '/',
    passive_mode INTEGER AS Boolean NOT NULL DEFAULT 1,
    ftps_implicit INTEGER AS Boolean NOT NULL DEFAULT 0,
    trust_self_signed INTEGER AS Boolean NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE TABLE remote_playback_history (
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    server_id INTEGER NOT NULL,
    remote_file_path TEXT NOT NULL,
    file_name TEXT NOT NULL,
    last_position_ms INTEGER NOT NULL DEFAULT 0,
    duration_ms INTEGER NOT NULL DEFAULT 0,
    is_completed INTEGER AS Boolean NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(server_id) REFERENCES remote_servers(_id) ON DELETE CASCADE,
    UNIQUE(server_id, remote_file_path)
);

CREATE INDEX remote_playback_history_server_id_index ON remote_playback_history(server_id);
